# Copy this file to .env and fill in real values.
# DO NOT commit .env (it's gitignored).

# Sentry DSN for the BACKEND project (.NET tier).
SENTRY_DSN=https://<placeholder>@oXXXXXX.ingest.sentry.io/XXXXXX

# Optional: tag every event with the deploy environment.
SENTRY_ENVIRONMENT=demo

# Port the backend listens on (default 5050 to avoid conflict with macOS 5000).
PORT=5050
