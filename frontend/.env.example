# Copy this file to .env and fill in real values.
# DO NOT commit .env (it's gitignored).

# Sentry DSN for the FRONTEND project (Next.js tier).
NEXT_PUBLIC_SENTRY_DSN=https://<placeholder>@oXXXXXX.ingest.sentry.io/XXXXXX

# Optional: tag every event with the deploy environment.
SENTRY_ENVIRONMENT=demo

# URL where the .NET backend is reachable. Leave UNSET to use the local
# synthetic-backend fallback (the demo still works without the .NET tier).
# Use 127.0.0.1 (not localhost) — Node's fetch resolves localhost to IPv6 (::1)
# first and the .NET backend binds IPv4 only, so localhost fails fast.
# BACKEND_URL=http://127.0.0.1:5050
